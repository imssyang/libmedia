{
    "version": 4,
    "configurations": [
        {
            "name": "MacOS",
            "includePath": [
                "${workspaceFolder}/src/**"
            ],
            "defines": [
                "__APPLE__"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-x64",
            "macFrameworkPath": [
                "/System/Library/Frameworks",
                "/Library/Frameworks"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/deps"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src/**",
                "/usr/include",
                "/usr/local/include"
            ],
            "defines": [
                "__LINUX__"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "configurationProvider": "ms-vscode.cmake-tools",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}/deps"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        }
    ]
}